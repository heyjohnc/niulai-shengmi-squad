{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider-neutral role output",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "claim_type", "text", "source_event_ids"],
  "properties": {
    "role": { "enum": ["YUNQUE", "NIULAI", "NIULAI_MAMA", "BAOLA"] },
    "claim_type": { "const": "INFERENCE" },
    "text": { "type": "string", "minLength": 2, "maxLength": 120 },
    "source_event_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
